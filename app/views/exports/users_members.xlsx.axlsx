# frozen_string_literal: true

wb = xlsx_package.workbook

header = wb.styles.add_style b: true, bg_color: Stylesheet.primary.upcase.gsub('#', 'FF'), fg_color: 'FFFFFFFF'
date = wb.styles.add_style format_code: Rails.application.secrets.excel_date_format

occupational_status = {
  '1' => 'Empregado',
  '2' => 'Desempregado',
  '3' => 'Empregador',
  '4' => 'Autônomo/Conta Própria',
  '5' => 'Profissional Liberal',
  '6' => '1º Emprego',
  '7' => 'Aposentado',
  '8' => 'Microempreendedor Individual - MEI',
  '9' => 'Aprendiz com contrato'
}

educational_levels = {
  '1' => 'Analfabeto',
  '2' => 'Até o 5º ano incompleto do ensino fundamental',
  '3' => '5º ano completo do ensino fundamental',
  '4' => 'Do 6º ao 9º ano do ensino fundamental',
  '5' => 'Ensino fundamental completo',
  '6' => 'Ensino médio incompleto',
  '7' => 'Ensino médio completo',
  '8' => 'Educação superior incompleto',
  '9' => 'Educação superior completo',
  'A' => 'Pós Grad. incompleto',
  'B' => 'Pós Grad. completo',
  'C' => 'Mestrado incompleto',
  'D' => 'Mestrado completo',
  'E' => 'Doutorado incompleto',
  'F' => 'Doutorado completo',
  'G' => 'Pós Dout. incompleto',
  'H' => 'Pós Dout. completo',
}

wb.add_worksheet(name: ExcelService.name_safe(t('export_members.members'))) do |sheet|
  ## data table
  # heading labels
  columns = [t('export_members.id'),
             t('export_members.external_id'),
             t('export_members.cpf'),
             t('export_members.first_name'),
             t('export_members.surname'),
             t('export_members.social_name'),           
             t('export_members.email'),
             t('export_members.newsletter'),
             t('export_members.last_login'),
             t('export_members.gender'),
             t('export_members.age'),
             t('export_members.zipcode'),
             t('export_members.street'),
             t('export_members.neighborhood'),
             t('export_members.number'),
             t('export_members.complement'),
             t('export_members.city'),
             t('export_members.state'),
             t('export_members.phone'),
             t('export_members.website'),
             t('export_members.job'),
             t('export_members.interests'),
             t('export_members.cad_software_mastered'),
             t('export_members.group'),
             t('export_members.subscription'),
             t('export_members.subscription_end_date'),
             t('export_members.validated_trainings'),
             t('export_members.tags'),
             t('export_members.number_of_invoices'),
             t('export_members.wallet'),
             t('export_members.projects'),
             t('export_members.facebook'),
             t('export_members.twitter'),
             t('export_members.echo_sciences'),
             t('export_members.organization'),
             t('export_members.organization_address'),
             t('export_members.note'),
             t('export_members.rg'),
             t('export_members.rg_date_emission'),
             t('export_members.rg_issuing_organization'),
             t('export_members.rg_issuing_state'),
             t('export_members.mother_name'),
             t('export_members.financial_responsible_cpf'),
             t('export_members.financial_responsible_name'),
             t('export_members.occupational_status'),
             t('export_members.education_level'),
             t('export_members.origin_state'),
             t('export_members.origin_city')]
  sheet.add_row columns, style: header

  # data rows
  members.each do |member|
    expiration = member&.subscription&.expired_at
    data = [
      member.id,
      member.invoicing_profile.external_id || '',
      member.profile.cpf,
      member.profile.first_name,
      member.profile.last_name,
      member.profile.social_name,
      member.email,
      member.is_allow_newsletter,
      member.last_sign_in_at&.to_date,
      member.statistic_profile.gender ? t('export_members.man') : t('export_members.woman'),
      member.statistic_profile.age,
      member.profile.zipcode,
      member.profile.street,
      member.profile.neighborhood,
      member.profile.number,
      member.profile.complement,
      member.profile.city,
      member.profile.state,
      member.profile.phone,
      member.profile.website,
      member.profile.job,
      member.profile.interest,
      member.profile.software_mastered,
      member.group&.name,
      expiration && DateTime.current < expiration ? member.subscription.plan.name : t('export_members.without_subscriptions'),
      expiration && DateTime.current < expiration ? member.subscription.expired_at.to_date : nil,
      member.trainings.map(&:name).join("\n"),
      member.tags.map(&:name).join("\n"),
      member.invoices.size,
      number_to_currency(member.wallet&.amount),
      member.projects.map(&:name).join("\n"),
      member.profile.facebook || '',
      member.profile.twitter || '',
      member.profile.echosciences || '',
      member.invoicing_profile&.organization&.name || '',
      member.invoicing_profile&.organization&.address&.address || '',
      ActionController::Base.helpers.sanitize(member.profile.note, tags: []) || '',
      member.profile.rg || '',
      member&.profile&.rg_date_emission&.to_date || nil,
      member.profile.rg_issuing_organization || '',
      member.profile.rg_issuing_state || '',
      member.profile.mother_name || '',
      member.profile.financial_responsible_cpf || '',
      member.profile.financial_responsible_name || '',
      member.profile.occupational_status ? occupational_status[member.profile.occupational_status] : '',
      member.profile.education_level ? educational_levels[member.profile.education_level] : '',
      member.profile.origin_state || '',
      member.profile.origin_city || ''
    ]
    styles = [nil, nil, nil, nil, nil, nil, nil, nil, date, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil,
              nil, nil, date, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, date, nil, nil, nil, nil, nil, nil, nil, nil, nil]

    types = %i[integer string string string string string string boolean date string integer string string string integer string string string string string string string string
               string string date string string integer string string string string string string string string string date string string string string string string string string string]

    sheet.add_row data, style: styles, types: types
  end
end
