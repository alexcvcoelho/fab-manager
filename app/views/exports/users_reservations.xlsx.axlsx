# frozen_string_literal: true

wb = xlsx_package.workbook

header = wb.styles.add_style b: true, bg_color: Stylesheet.primary.upcase.gsub('#', 'FF'), fg_color: 'FFFFFFFF'
date = wb.styles.add_style format_code: Rails.application.secrets.excel_date_format

wb.add_worksheet(name: ExcelService.name_safe(t('export_reservations.reservations'))) do |sheet|

  ## data table
  # heading labels
  columns = [
              t('export_reservations.customer_id'), 
              t('export_reservations.cpf'), 
              t('export_reservations.customer'), 
              t('export_reservations.email'),
              t('export_reservations.reservation_date'), 
              t('export_reservations.reservation_type'), 
              t('export_reservations.reservation_object'),
              t('export_reservations.slots_number_hours_tickets'), 
              t('export_reservations.payment_method'), 
              t('export_reservations.coupon'),
              t('export_reservations.pagseguro_identifier'), 
              t('export_reservations.nsu'),  
              t('export_reservations.paid_at'), 
              t('export_reservations.installments'),
              t('export_reservations.paid_value'), 
              t('export_reservations.slots_reserved')
            ]
  sheet.add_row columns, style: header

  # data rows
  reservations.each do |resrv|
    invoice = resrv.original_invoice
    puts invoice&.getnet_transaction&.payload&.class
    getnet_transaction = invoice&.getnet_transaction&.payload
    payment_gateway_object = invoice&.payment_gateway_object
    data = [
      resrv.user&.id,
      resrv.user&.profile&.cpf,
      resrv.user&.profile&.full_name || t('export_reservations.deleted_user'),
      resrv.user&.email,
      resrv.created_at.to_date,
      resrv.reservable_type,
      resrv.reservable.nil? ? '' : resrv.reservable.name,
      resrv.reservable_type == 'Event' ? resrv.total_booked_seats : resrv.slots.count,
      invoice&.paid_by_card? ? t('export_reservations.online_payment') : invoice&.paid_by_boleto? ? t('export_reservations.boleto')  : t('export_reservations.local_payment'),
      invoice&.coupon&.nil? ? '' : invoice&.coupon&.name,
      getnet_transaction&.dig("order_id"),
      getnet_transaction&.dig("credit", "terminal_nsu"),
      getnet_transaction&.dig("received_at")&.to_date,
      "1",      
      number_to_currency((getnet_transaction&.dig("amount") || 0) / 100.00),
      resrv.slots_to_string
    ]
    styles = [nil, nil, nil, nil, date, nil, nil, nil, nil, nil, nil, nil, date, nil, nil, nil]
    types = %i[integer string string string date string string integer string string string string date integer string string]

    sheet.add_row data, style: styles, types: types
  end
end
